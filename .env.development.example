# Copy this file to .env.development and fill in the private values.
PUBLIC_ENV_MODE=development

# Public frontend and self-hosted Convex routes for this environment.
PUBLIC_BASE_URL_SITE=http://localhost:5173
PUBLIC_BASE_URL_APP=http://localhost:5173
PUBLIC_BASE_URL_CONVEX=https://solid-convex-backend.wonder1.de
PUBLIC_BASE_URL_API=https://solid-convex-api.wonder1.de
VITE_CONVEX_URL=https://solid-convex-backend.wonder1.de
VITE_CONVEX_SITE_URL=https://solid-convex-api.wonder1.de
CONVEX_SITE_URL=https://solid-convex-api.wonder1.de

# Convex CLI target and admin credential. Never commit the environment file.
CONVEX_SELF_HOSTED_URL=https://solid-convex-backend.wonder1.de
CONVEX_SELF_HOSTED_ADMIN_KEY=replace-with-preview-admin-key

# Application secret used by the generic auth scaffold and synced to Convex.
AUTH_SECRET=replace-with-development-secret

# BEGIN project-creator assets-service settings
# Assets-service settings for this project. Fill non-secret values locally or in deployment configuration.
ASSETS_API_URL=https://assets-service.contentoren.de
ASSETS_PROJECT=solid-convex
ASSETS_ENVIRONMENT=development

# Credential reference only: provide ASSETS_TOKEN through the environment or a secret manager.
# The credential value is intentionally not generated here.
# Organization reference: ASSETS_ORGANIZATION
# END project-creator assets-service settings
# BEGIN authworks pilot (managed: solid-convex <-> authworks.contentoren.de)
# Parallel Authworks OIDC provider (authorization-code + PKCE).
# Copy the real values from the provisioned .env file; never commit secrets.
AUTHWORKS_ISSUER="https://authworks.contentoren.de"
AUTHWORKS_CLIENT_ID="replace-with-authworks-client-uuid"
AUTHWORKS_CLIENT_SECRET="replace-with-authworks-client-secret"
AUTHWORKS_REDIRECT_URI="https://solid-convex-api.wonder1.de/api/auth/authworks/callback"
AUTHWORKS_SCOPE="openid profile email"
AUTHWORKS_ORGANIZATION_ID="01a03273-0662-7b18-9b48-3a7ab29f0bfd"
# Optional login restriction (server only); see ops/README.md before enabling.
# AUTHWORKS_ADMISSION_ORGANIZATION_ID="<authworks-organization-uuid>"
AUTHWORKS_PROJECT_ID="replace-with-authworks-project-id"
AUTHWORKS_SERVICE_ACCOUNT_CLIENT_ID="solid-convex-sync"
AUTHWORKS_SERVICE_ACCOUNT_CLIENT_SECRET="replace-with-authworks-service-account-secret"
# END authworks pilot

# DEV server port and origins (use your dev lease values, never preview port 3022)
PORT=5173
HOST=127.0.0.1
