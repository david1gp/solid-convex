[Unit]
Description=solid-convex adaptive checkout frontend (rsbuild, :3016)
After=network-online.target

[Service]
Nice=7
Type=simple
WorkingDirectory=/home/leo/projects/solid-convex
Environment=PATH=/home/leo/.local/bin:/home/leo/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/leo/.bun/bin/bun --env-file=.env.development --env-file=.env.runtime ./node_modules/@rsbuild/core/bin/rsbuild.js dev --host 127.0.0.1
Restart=on-failure
RestartSec=2
StandardOutput=append:/tmp/opencode/solid-convex-adaptive-runtime/frontend.log
StandardError=append:/tmp/opencode/solid-convex-adaptive-runtime/frontend.log

[Install]
WantedBy=default.target
