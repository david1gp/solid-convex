[Unit]
Description=solid-convex vite development server
After=network-online.target
Wants=network-online.target

[Service]
Nice=7
MemoryHigh=3G
MemoryMax=4G
Type=simple
WorkingDirectory=/home/leo/projects/solid-convex
Environment=PATH=/home/leo/.local/bin:/home/leo/.bun/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/home/leo/projects/solid-convex/.env.development
EnvironmentFile=-/home/leo/.config/solid-convex/preview-web.env
ExecStart=/home/leo/.bun/bin/bun run dev -- --host 127.0.0.1 --port ${PREVIEW_WEB_PORT}
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=inherit

[Install]
WantedBy=default.target
