{
  "name": "solid-convex",
  "version": "0.1.0",
  "scripts": {
    "cc": "clear && bun --env-file=.env.development run convex codegen",
    "t": "clear && bun --check",
    "type-check": "bun --check",
    "deploy": "bun run frontend:deploy",
    "deploy:production": "bun run convex:deploy:production && bun run deploy",
    "frontend:deploy": "bun run rsbuild:deploy",
    "frontend:upload": "bun run wrangler pages deploy ./dist --project-name=adaptive-solid-convex --branch=main --commit-dirty=true",
    "frontend:tag": "git branch -f frontend",
    "frontend:create": "bunx wrangler pages project create solid-convex --production-branch=main",
    "dev": "bun run rsbuild:dev",
    "vite:dev": "clear && nice -5 vite dev --debug hmr",
    "vite:build": "nice -15 vite build",
    "vite:deploy": "bun run vite:build && bun run frontend:upload && bun run frontend:tag",
    "vite:clean": "rm -rf ./node_modules/.vite/deps",
    "build": "bun run rsbuild:build",
    "rsbuild:dev": "(clear 2>/dev/null || true) && nice -5 rsbuild dev",
    "rsbuild:build": "nice -15 rsbuild build",
    "rsbuild:deploy": "bun --env-file=.env.production run rsbuild build && bun run frontend:upload && git tag -f frontend",
    "rsbuild:clean": "rm -rf node_modules/.cache",
    "format": "biome format --write convex functions src package.json tsconfig.json biome.json",
    "format:check": "biome format convex functions src package.json tsconfig.json biome.json",
    "check": "bun run format:check && bun run type-check && bun run test && bun run test:reactivity-dev",
    "lint:convex": "eslint convex src",
    "test": "bun test --conditions=browser --isolate --env-file .env.development --path-ignore-patterns='convex-tests/**' --path-ignore-patterns='e2e/**'",
    "test:reactivity-dev": "bun test --conditions=browser --conditions=development src/utils/convex_client/cursorPaginationCreate.test.ts src/utils/convex_client/queryCreate.test.ts",
    "test:w": "bun test --isolate --env-file .env.development --path-ignore-patterns=convex-tests/** --watch",
    "test:e2e": "bun e2e/e2eRun.ts production",
    "test:e2e:dev": "bun e2e/e2eRun.ts dev",
    "test:convex": "bun run convex codegen --system-udfs --typecheck disable && bunx vitest run --config vitest.convex.config.ts",
    "convex:dev": "export CI=1 && clear && bun run convex dev --env-file=.env.development",
    "convex:logs:development": "bun ./node_modules/convex/bin/main.js logs --env-file .env.development",
    "convex:logs:production": "bun ./node_modules/convex/bin/main.js logs --env-file .env.production",
    "convex:env:upload:development": "bash ops/convex/preview.bash env",
    "convex:env:upload:production": "bash ops/convex/production.bash env",
    "convex:deploy:production": "bash ops/convex/production.bash deploy",
    "convex:dev:dev": "export CI=1 && clear && convex dev --local",
    "convex:dev:test": "export CI=1 && convex dev --local --once",
    "convex:test": "export CI=1 && convex dev --local --once",
    "convex:backend:update": "podman auto-update",
    "ui": "rsync -avh --delete ../../adaptive/solid-ui/ui/ ./ui/",
    "ui:push": "rsync -avh --delete ./ui/  ../../adaptive/solid-ui/ui/",
    "generateDemoList": "bun run ./src/app/demos/generateDemoList.cli.ts",
    "generateTranslations": "bun run ./src/app/i18n/generateTranslations.ts",
    "cli": "bun run src/cli/cli.ts",
    "update": "bun x npm-check-updates -u && bun i",
    "update:commit": "bun x npm-check-updates -u && bun i && git add package.json && bun check && git commit -m \"chore(deps): update dependencies\" && git push",
    "clean": "rm -rf ./dist",
    "reset": "rm -rf ./node_modules",
    "build:preview": "bun --no-env-file scripts/previewBuild.ts",
    "preview:start": "bun --no-env-file scripts/previewServer.ts",
    "preview:deploy": "bun run build:preview && project-registry svc restart solid-convex --service preview-web && bash scripts/previewHealth.bash",
    "preview:status": "project-registry svc status solid-convex --service preview-web",
    "preview:logs": "project-registry svc logs solid-convex --service preview-web",
    "convex:deploy:preview": "bash ops/convex/preview.bash deploy",
    "deploy:preview": "bun run convex:deploy:preview && bun run preview:deploy"
  },
  "dependencies": {
    "@adaptive-ds/email-generator": "^0.21.0",
    "@adaptive-ds/mdi": "^0.1.2",
    "@adaptive-ds/result": "^0.6.0",
    "@adaptive-ds/utils": "^0.14.0",
    "@adaptive-ds/zitadel-cli": "0.3.1",
    "@bradenmacdonald/s3-lite-client": "^1.0.1",
    "@corvu-next/dialog": "0.1.5",
    "@corvu-next/popover": "0.1.5",
    "@floating-ui/dom": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@solid-primitives/keyed": "^3.0.0",
    "@solid-primitives/scheduled": "^2.0.0",
    "@solidjs/web": "^2.0.3",
    "@tanstack/solid-router": "2.0.0-rc.10",
    "cn": "^0.5.2",
    "convex": "^1.51.0",
    "dayjs": "^1.11.23",
    "hono": "^4.13.19",
    "jose": "^6.2.18",
    "jwt-decode": "^4.0.0",
    "posthog-js": "^1.453.2",
    "solid-js": "^2.0.3",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@convex-dev/eslint-plugin": "^5.0.1",
    "@edge-runtime/vm": "^5.0.0",
    "@rsbuild/core": "^2.3.3",
    "@rsbuild/plugin-babel": "^2.1.0",
    "@rsbuild/plugin-node-polyfill": "^1.4.6",
    "@rsbuild/plugin-solid": "^2.1.0",
    "@rstest/core": "^0.12.6",
    "@rstest/playwright": "^0.12.6",
    "@solidjs/vite-plugin": "^3.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "latest",
    "@typescript-eslint/parser": "^8.73.0",
    "autoprefixer": "^10.7.0",
    "convex-test": "^0.0.73",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "glob": "^14.0.6",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "ts-morph": "^28.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "overrides": {
    "solid-js": "^2.0.3"
  },
  "imports": {
    "#convex/*": "./convex/*",
    "#src/*": "./src/*",
    "#ui/*": "./ui/*",
    "#utils/*": "@adaptive-ds/utils/*",
    "#result": "@adaptive-ds/result",
    "#result/*": "@adaptive-ds/result/*"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120,
    "trailingComma": "all"
  },
  "type": "module",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/david1gp/solid-convex",
  "description": "Build authenticated SolidJS apps lightning-fast with Convex",
  "keywords": [
    "convex",
    "authentication",
    "auth",
    "solidjs",
    "solid-js",
    "ui-components",
    "reactive",
    "frontend",
    "adaptive",
    "login",
    "signup",
    "session",
    "convex-backend",
    "convex-auth",
    "jwt"
  ],
  "repository": {
    "url": "git+https://github.com/david1gp/solid-convex.git"
  },
  "patchedDependencies": {
    "@corvu-next/focus-trap@0.1.4": "patches/@corvu-next%2Ffocus-trap@0.1.4.patch"
  }
}
